# Copy this file to .env and set values for your environment.
# .env is git-ignored — never commit it.

# OPC UA server endpoint the client connects to.
# In Docker Compose the server is reachable via the service name.
OPCUA_SERVER_URL=opc.tcp://opc-server:4840/

# NATS broker URL for publishing PartCounter values.
# host.docker.internal resolves to the host machine from inside Docker.
NATS_URL=nats://host.docker.internal:4222
